@model MvcMovie.ViewModels.EditUserRolesViewModel

<h2>Edit Roles for: @Model.UserName</h2>
<form asp-action="EditUserRoles" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="UserName" />

    @for (int i = 0; i < Model.Roles.Count; i++)
    {
        <div class="form-check">
            <input type="hidden" asp-for="@Model.Roles[i].RoleId" />
            <input type="hidden" asp-for="@Model.Roles[i].RoleName" />
            <input type="checkbox" class="form-check-input" asp-for="@Model.Roles[i].IsSelected" />
            <label class="form-check-label">
                @Model.Roles[i].RoleName
            </label>
        </div>
    }

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>