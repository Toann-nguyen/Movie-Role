@* @model MvcMovie.Models.LoginViewModel

<div style="background-color: black; width: 100%; height: 150px;"></div>

<div class="container-xxl"
    style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column; justify-content: center; align-items: center;">
    <h2 style="font-size: 2rem; color: #333; text-align: center; font-weight: bold; margin-bottom: 20px;">Sign Up</h2>

    <form method="post"
        style="max-width: 400px; width: 100%; background-color: #fff; padding: 30px 40px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">

        <div style="margin-bottom: 20px;">
            <label asp-for="Email" style="font-size: 1rem; color: #555;">Email</label>
            <input asp-for="Email" class="form-control"
                style="padding: 10px; font-size: 1rem; border-radius: 8px; border: 1px solid #ccc; width: 100%; transition: border-color 0.3s;"
                placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger"
                style="font-size: 0.875rem; color: red; margin-top: 5px;"></span>
        </div>

        <div style="margin-bottom: 20px;">
            <label asp-for="Password" style="font-size: 1rem; color: #555;">Password</label>
            <input asp-for="Password" type="password" class="form-control"
                style="padding: 10px; font-size: 1rem; border-radius: 8px; border: 1px solid #ccc; width: 100%; transition: border-color 0.3s;"
                placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger"
                style="font-size: 0.875rem; color: red; margin-top: 5px;"></span>
        </div>



        <button type="submit" class="btn btn-primary"
            style="width: 100%; padding: 12px; font-size: 1.1rem; border-radius: 8px; background-color: #007bff; color: white; border: none; transition: background-color 0.3s;">
            Sign Up
        </button>
    </form>
</div>

<style>
    /* Chỉnh sửa border khi hover vào input */
    .form-control:focus {
        border-color: #007bff;
        outline: none;
    }

    /* Chỉnh sửa màu sắc của button khi hover */
    .btn-primary:hover {
        background-color: #0056b3;
        cursor: pointer;
    }
</style> *@
