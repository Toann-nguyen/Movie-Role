@using MvcMovie.ViewModels
@model List<MvcMovie.ViewModels.UserViewModel>

<h2>User Management</h2>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
            <th>Roles</th>
            <th>Permissions</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var userVM in Model)
        {
            <tr>
                <td>@userVM.User!.UserName</td>
                <td>@userVM.User.Email</td>
                @* <td>@userVM.User.Status</td> *@
                <td>@string.Join(", ", userVM.Roles!)</td>
                <td>@string.Join(", ", userVM.Permissions!.Select(p => p.Name))</td>
                <td>
                    <a asp-action="EditUserRoles" asp-route-userId="@userVM.User.Id" class="btn btn-primary">Edit Roles</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@* 
